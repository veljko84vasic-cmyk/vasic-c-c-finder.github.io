{
  "name": "nebulax-launcher",
  "version": "1.0.0",
  "description": "NebulaX Client Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.nebulax.launcher",
    "productName": "NebulaX Launcher",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ]
  }
}
